---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('ai-digest')).filter((post) => !post.data.draft);

  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/i, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={post.data.description ?? post.data.title} />
    <title>{post.data.title} · docClaw Public Pages</title>
  </head>
  <body>
    <main class="page">
      <a class="back" href="/">← 返回列表</a>
      <article>
        <header>
          <p class="eyebrow">AI digest</p>
          <h1>{post.data.title}</h1>
          <div class="meta">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            {post.data.tags.length > 0 && (
              <ul aria-label="标签">
                {post.data.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            )}
          </div>
          {post.data.description && <p class="description">{post.data.description}</p>}
        </header>
        <div class="content">
          <Content />
        </div>
      </article>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --bg: #f7f3ea;
    --surface: #fffaf1;
    --ink: #1f1b16;
    --muted: #6b6258;
    --border: #e4d9c7;
    --accent: #8f4f2f;
    --accent-soft: #ead3c4;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
    font-family:
      ui-serif, Georgia, Cambria, "Times New Roman", "Noto Serif SC", serif;
    line-height: 1.7;
  }

  a {
    color: inherit;
  }

  .page {
    width: min(100%, 760px);
    margin: 0 auto;
    padding: clamp(24px, 7vw, 72px) clamp(18px, 5vw, 28px) 80px;
  }

  .back {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    margin-bottom: 28px;
    color: var(--accent);
    font: 700 0.92rem/1 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", sans-serif;
    text-decoration: none;
  }

  article {
    padding: clamp(24px, 6vw, 48px);
    border: 1px solid var(--border);
    border-radius: 30px;
    background: var(--surface);
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--accent);
    font: 700 0.76rem/1.2 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1,
  h2,
  p,
  li {
    text-wrap: pretty;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 10vw, 5.2rem);
    line-height: 0.98;
    letter-spacing: -0.065em;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 14px;
    align-items: center;
    margin-top: 22px;
    color: var(--muted);
    font: 600 0.9rem/1.4 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", sans-serif;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    border: 1px solid var(--accent-soft);
    border-radius: 999px;
    padding: 5px 10px;
    color: var(--accent);
    background: rgba(234, 211, 196, 0.34);
    font: 700 0.76rem/1 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .description {
    margin: 24px 0 0;
    color: var(--muted);
    font: 400 1.12rem/1.75 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", sans-serif;
  }

  .content {
    margin-top: 36px;
    font-size: clamp(1.05rem, 2vw, 1.18rem);
  }

  .content :global(h2) {
    margin: 2.2em 0 0.5em;
    font-size: clamp(1.5rem, 4vw, 2rem);
    line-height: 1.18;
    letter-spacing: -0.035em;
  }

  .content :global(p) {
    margin: 1.05em 0;
  }

  .content :global(ul),
  .content :global(ol) {
    display: block;
    margin: 1.1em 0;
    padding-left: 1.3em;
  }

  .content :global(li) {
    border: 0;
    border-radius: 0;
    padding: 0;
    color: inherit;
    background: transparent;
    font: inherit;
  }

  .content :global(code) {
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 0.12em 0.36em;
    background: rgba(255, 255, 255, 0.52);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.88em;
  }
</style>
