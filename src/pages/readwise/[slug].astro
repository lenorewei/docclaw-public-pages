---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('readwise')).filter((post) => !post.data.draft);

  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/i, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={post.data.description ?? post.data.title} />
    <title>{post.data.title} · Readwise</title>
  </head>
  <body>
    <main class="page">
      <a class="back" href="/">← 返回列表</a>
      <article>
        <header>
          <p class="eyebrow">READWISE REVIEW</p>
          <h1>{post.data.title}</h1>
          <div class="meta">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            {post.data.tags.length > 0 && (
              <ul aria-label="标签">
                {post.data.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            )}
          </div>
          {post.data.description && <p class="description">{post.data.description}</p>}
        </header>
        <div class="content">
          <Content />
        </div>
      </article>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --bg: #f7f6f2;
    --surface: #ffffff;
    --ink: rgba(0, 0, 0, 0.92);
    --muted: #615d59;
    --muted-2: #8b8680;
    --border: rgba(0, 0, 0, 0.1);
    --accent: #0075de;
    --accent-soft: #f2f9ff;
    --shadow: rgba(0, 0, 0, 0.04) 0px 4px 18px, rgba(0, 0, 0, 0.027) 0px 2px 8px,
      rgba(0, 0, 0, 0.02) 0px 1px 3px;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
    line-height: 1.68;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--accent);
  }

  .page {
    width: min(100%, 760px);
    margin: 0 auto;
    padding: 48px 22px 80px;
  }

  .back {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    margin-bottom: 20px;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
  }

  .back:hover,
  .back:focus-visible {
    color: var(--accent);
  }

  article {
    padding: 42px;
    border: 1px solid var(--border);
    border-radius: 22px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.2;
  }

  h1,
  h2,
  p,
  li {
    text-wrap: pretty;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 7vw, 4.2rem);
    line-height: 1.06;
    letter-spacing: -0.055em;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 14px;
    align-items: center;
    margin-top: 20px;
    color: var(--muted-2);
    font-size: 0.9rem;
    font-weight: 600;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    border-radius: 999px;
    padding: 5px 10px;
    color: var(--accent);
    background: var(--accent-soft);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
  }

  .description {
    margin: 22px 0 0;
    color: var(--muted);
    font-size: 1.04rem;
    font-weight: 500;
    line-height: 1.72;
  }

  .content {
    margin-top: 34px;
    color: var(--ink);
    font-size: 1.04rem;
  }

  .content :global(h2) {
    margin: 2em 0 0.55em;
    font-size: clamp(1.35rem, 4vw, 1.85rem);
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .content :global(p) {
    margin: 1em 0;
  }

  .content :global(ul),
  .content :global(ol) {
    display: block;
    margin: 1em 0;
    padding-left: 1.25em;
  }

  .content :global(li) {
    margin: 0.45em 0;
    border: 0;
    border-radius: 0;
    padding: 0;
    color: inherit;
    background: transparent;
    font: inherit;
  }

  .content :global(code) {
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.12em 0.36em;
    background: #fbfaf7;
    color: var(--ink);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.88em;
  }

  @media (max-width: 640px) {
    .page {
      padding: 22px 14px 56px;
    }

    article {
      padding: 24px;
      border-radius: 18px;
    }

    h1 {
      font-size: 2.15rem;
      line-height: 1.12;
      letter-spacing: -0.04em;
    }

    .description,
    .content {
      font-size: 0.98rem;
    }
  }
</style>
