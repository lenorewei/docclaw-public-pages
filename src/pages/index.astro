---
import { getCollection } from 'astro:content';
import '../styles/site.css';

const posts = (await getCollection('daily'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featured = posts[0];

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);

const hrefFor = (id: string) => `/daily/${id.replace(/\.(md|mdx)$/i, '')}/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="AIHOT 和 Readwise 的公开每日简报。微信里看短摘要，点进来看完整内容。"
    />
    <title>Daily Digest · Lenore Wei</title>
  </head>
  <body>
    <main class="shell">
      <section class="hero" aria-labelledby="page-title">
        <p class="eyebrow">DAILY DIGEST</p>
        <h1 id="page-title">每日简报</h1>
        <p class="lede">公开可分享的一页日报：AIHOT 动态 + Readwise 每日回顾入口，不放私人记录。</p>
      </section>

      <section class="posts" aria-labelledby="digest-title">
        <div class="section-heading">
          <p class="eyebrow">LATEST</p>
          <h2 id="digest-title">最近更新</h2>
        </div>
      </nav>

      <section class="home-hero" aria-labelledby="page-title">
        <div>
          <p class="eyebrow">AI DIGEST</p>
          <h1 id="page-title">AI 建造者动态</h1>
          <p>微信晨报的详细版。只放公开内容，不接 Obsidian，不放私人记录。</p>
        </div>
        <div class="hero-note" aria-label="站点说明">
          <strong>Public notes, compact by design.</strong>
          <p>source: public feeds<br />format: long digest<br />scope: AI builders</p>
        </div>
      </section>

      {
        featured ? (
          <section class="featured-panel" aria-labelledby="featured-title">
            <div class="feature-visual" aria-hidden="true">
              <svg viewBox="0 0 320 200" fill="none" role="img">
                <rect x="35" y="42" width="58" height="42" rx="2" stroke="currentColor" />
                <rect x="132" y="30" width="72" height="56" rx="2" stroke="currentColor" />
                <rect x="222" y="112" width="64" height="46" rx="2" stroke="currentColor" />
                <circle cx="74" cy="136" r="21" stroke="currentColor" />
                <path d="M94 64H126M169 88V126M101 136H214M204 128L222 128" stroke="currentColor" />
                <path d="M143 49H192M143 66H178M238 128H274M238 144H263" stroke="currentColor" />
              </svg>
            </div>
            <div class="feature-copy">
              <p class="section-kicker">最新文章</p>
              <h2 id="featured-title">
                <a href={hrefFor(featured.id)}>{featured.data.title}</a>
              </h2>
              {featured.data.description && <p>{featured.data.description}</p>}
              <div class="feature-meta">
                <time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time>
                <span>AI Digest</span>
              </div>
              {
                featured.data.tags.length > 0 && (
                  <ul class="tag-list" aria-label="标签">
                    {featured.data.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                )
              }
            </div>
          </section>
        ) : (
          <p class="empty-state">还没有公开文章。</p>
        )
      }

      {
        posts.length > 0 && (
          <section class="posts-section" aria-labelledby="digest-title">
            <div class="section-heading">
              <div>
                <p class="section-kicker">Latest</p>
                <h2 id="digest-title">最近更新</h2>
              </div>
            </div>

            <div class="post-list">
              {posts.map((post) => (
                <article class="post-row">
                  <a href={hrefFor(post.id)}>
                    <time class="post-date" datetime={post.data.date.toISOString()}>
                      {formatDate(post.data.date)}
                    </time>
                    <div>
                      <h3>{post.data.title}</h3>
                      {post.data.description && <p>{post.data.description}</p>}
                    </div>
                    {post.data.tags.length > 0 && (
                      <ul class="tag-list" aria-label="标签">
                        {post.data.tags.map((tag) => <li>{tag}</li>)}
                      </ul>
                    )}
                  </a>
                </article>
              ))}
            </div>
          </section>
        )
      }
    </main>
  </body>
</html>
