---
import { getCollection } from 'astro:content';

const posts = (await getCollection('daily'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);

const hrefFor = (id: string) => `/daily/${id.replace(/\.(md|mdx)$/i, '')}/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="AIHOT 和 Readwise 的公开每日简报。微信里看短摘要，点进来看完整内容。"
    />
    <title>Daily Digest · Lenore Wei</title>
  </head>
  <body>
    <main class="shell">
      <section class="hero" aria-labelledby="page-title">
        <p class="eyebrow">DAILY DIGEST</p>
        <h1 id="page-title">每日简报</h1>
        <p class="lede">公开可分享的一页日报：AIHOT 动态 + Readwise 每日回顾入口，不放私人记录。</p>
      </section>

      <section class="posts" aria-labelledby="digest-title">
        <div class="section-heading">
          <p class="eyebrow">LATEST</p>
          <h2 id="digest-title">最近更新</h2>
        </div>

        {posts.length > 0 ? (
          <div class="post-list">
            {posts.map((post) => (
              <article class="post-card">
                <a href={hrefFor(post.id)}>
                  <div class="post-main">
                    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                    <h3>{post.data.title}</h3>
                    {post.data.description && <p>{post.data.description}</p>}
                  </div>
                  {post.data.tags.length > 0 && (
                    <ul aria-label="标签">
                      {post.data.tags.map((tag) => <li>{tag}</li>)}
                    </ul>
                  )}
                </a>
              </article>
            ))}
          </div>
        ) : (
          <p class="empty">还没有公开文章。</p>
        )}
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --bg: #f7f6f2;
    --surface: #ffffff;
    --surface-soft: #fbfaf7;
    --ink: rgba(0, 0, 0, 0.92);
    --muted: #615d59;
    --muted-2: #8b8680;
    --border: rgba(0, 0, 0, 0.1);
    --accent: #0075de;
    --accent-soft: #f2f9ff;
    --shadow: rgba(0, 0, 0, 0.04) 0px 4px 18px, rgba(0, 0, 0, 0.027) 0px 2px 8px,
      rgba(0, 0, 0, 0.02) 0px 1px 3px;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .shell {
    width: min(100%, 880px);
    margin: 0 auto;
    padding: 56px 22px 72px;
  }

  .hero {
    padding: 42px;
    border: 1px solid var(--border);
    border-radius: 22px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.2;
  }

  h1,
  h2,
  h3,
  p {
    text-wrap: pretty;
  }

  h1 {
    margin: 0;
    max-width: 12ch;
    font-size: clamp(2.7rem, 8vw, 4.8rem);
    line-height: 1.02;
    letter-spacing: -0.06em;
  }

  .lede {
    max-width: 36rem;
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 1.08rem;
    font-weight: 500;
    line-height: 1.7;
  }

  .posts {
    margin-top: 42px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.55rem, 4vw, 2.2rem);
    line-height: 1.1;
    letter-spacing: -0.045em;
  }

  .post-list {
    display: grid;
    gap: 12px;
  }

  .post-card a {
    display: grid;
    gap: 20px;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    box-shadow: rgba(0, 0, 0, 0.02) 0 1px 3px;
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .post-card a:hover,
  .post-card a:focus-visible {
    transform: translateY(-1px);
    border-color: rgba(0, 117, 222, 0.32);
    box-shadow: var(--shadow);
    outline: none;
  }

  time {
    display: block;
    margin-bottom: 8px;
    color: var(--muted-2);
    font-size: 0.88rem;
    font-weight: 600;
  }

  h3 {
    margin: 0;
    font-size: clamp(1.22rem, 3vw, 1.7rem);
    line-height: 1.22;
    letter-spacing: -0.035em;
  }

  .post-card p,
  .empty {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-self: end;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    border-radius: 999px;
    padding: 5px 10px;
    color: var(--accent);
    background: var(--accent-soft);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
  }

  @media (min-width: 720px) {
    .post-card a {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }

  @media (max-width: 640px) {
    .shell {
      padding: 22px 14px 48px;
    }

    .hero {
      padding: 24px;
      border-radius: 18px;
    }

    h1 {
      max-width: none;
      font-size: 2.35rem;
      line-height: 1.08;
      letter-spacing: -0.04em;
    }

    .lede {
      margin-top: 14px;
      font-size: 0.98rem;
      line-height: 1.65;
    }

    .posts {
      margin-top: 28px;
    }

    .section-heading {
      display: block;
      margin-bottom: 12px;
    }

    .post-card a {
      padding: 18px;
      border-radius: 14px;
    }
  }
</style>
