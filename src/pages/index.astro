---
import { getCollection } from 'astro:content';

const posts = (await getCollection('ai-digest'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="一个独立的 public-pages 静态站，用来发布 AI digest 和适合微信打开的公开页面。"
    />
    <title>docClaw Public Pages</title>
  </head>
  <body>
    <main class="shell">
      <section class="hero" aria-labelledby="page-title">
        <p class="eyebrow">docClaw public pages</p>
        <h1 id="page-title">公开页面，只放该公开的内容。</h1>
        <p class="lede">
          这里是独立的 Astro 静态站。内容直接写在这个 repo 里，不读取、不同步、不暴露
          Obsidian vault。
        </p>
      </section>

      <section class="posts" aria-labelledby="digest-title">
        <div class="section-heading">
          <p class="eyebrow">AI digest</p>
          <h2 id="digest-title">近期文章</h2>
        </div>

        {posts.length > 0 ? (
          <div class="post-list">
            {posts.map((post) => (
              <article class="post-card">
                <a href={`/ai-digest/${post.id.replace(/\.(md|mdx)$/i, "")}/`}>
                  <div>
                    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                    <h3>{post.data.title}</h3>
                    {post.data.description && <p>{post.data.description}</p>}
                  </div>
                  {post.data.tags.length > 0 && (
                    <ul aria-label="标签">
                      {post.data.tags.map((tag) => <li>{tag}</li>)}
                    </ul>
                  )}
                </a>
              </article>
            ))}
          </div>
        ) : (
          <p class="empty">还没有公开文章。</p>
        )}
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --bg: #f7f3ea;
    --surface: #fffaf1;
    --surface-strong: #ffffff;
    --ink: #1f1b16;
    --muted: #6b6258;
    --border: #e4d9c7;
    --accent: #8f4f2f;
    --accent-soft: #ead3c4;
    --shadow: 0 24px 70px rgba(59, 43, 28, 0.12);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at top left, rgba(143, 79, 47, 0.16), transparent 36rem),
      var(--bg);
    color: var(--ink);
    font-family:
      ui-serif, Georgia, Cambria, "Times New Roman", "Noto Serif SC", serif;
    line-height: 1.6;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .shell {
    width: min(100%, 920px);
    margin: 0 auto;
    padding: clamp(32px, 8vw, 88px) clamp(18px, 4vw, 32px) 72px;
  }

  .hero {
    padding: clamp(28px, 6vw, 56px);
    border: 1px solid var(--border);
    border-radius: 32px;
    background: color-mix(in srgb, var(--surface) 90%, white);
    box-shadow: var(--shadow);
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--accent);
    font: 700 0.76rem/1.2 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    text-wrap: pretty;
  }

  h1 {
    max-width: 11ch;
    margin: 0;
    font-size: clamp(3rem, 12vw, 7.5rem);
    line-height: 0.92;
    letter-spacing: -0.075em;
  }

  .lede {
    max-width: 42rem;
    margin: 28px 0 0;
    color: var(--muted);
    font: 400 clamp(1.05rem, 2vw, 1.28rem)/1.75 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", sans-serif;
  }

  .posts {
    margin-top: clamp(34px, 7vw, 68px);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.65rem, 4vw, 2.4rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .post-list {
    display: grid;
    gap: 14px;
  }

  .post-card a {
    display: grid;
    gap: 22px;
    min-height: 44px;
    padding: clamp(20px, 5vw, 30px);
    border: 1px solid var(--border);
    border-radius: 24px;
    background: rgba(255, 250, 241, 0.76);
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .post-card a:hover,
  .post-card a:focus-visible {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 42%, var(--border));
    background: var(--surface-strong);
    outline: none;
  }

  time {
    display: block;
    margin-bottom: 8px;
    color: var(--muted);
    font: 600 0.86rem/1.4 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  h3 {
    margin: 0;
    font-size: clamp(1.35rem, 4vw, 2rem);
    line-height: 1.16;
    letter-spacing: -0.035em;
  }

  .post-card p,
  .empty {
    margin: 10px 0 0;
    color: var(--muted);
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", sans-serif;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    border: 1px solid var(--accent-soft);
    border-radius: 999px;
    padding: 5px 10px;
    color: var(--accent);
    background: rgba(234, 211, 196, 0.34);
    font: 700 0.76rem/1 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  @media (min-width: 720px) {
    .post-card a {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
</style>
