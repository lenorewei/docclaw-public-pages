---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('daily')).filter((post) => !post.data.draft);

  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/i, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={post.data.description ?? post.data.title} />
    <title>{post.data.title} · Daily Digest</title>
  </head>
  <body>
    <div class="ambient ambient-a"></div>
    <div class="ambient ambient-b"></div>
    <main class="page">
      <nav class="topbar" aria-label="页面导航">
        <a class="back" href="/">← 返回</a>
        <span class="pill">Daily Digest</span>
      </nav>

      <article class="shell">
        <header class="hero">
          <div>
            <p class="eyebrow">PUBLIC DAILY BRIEF</p>
            <h1>{post.data.title}</h1>
          </div>
          <div class="date-card">
            <span>DATE</span>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          </div>
        </header>

        <div class="meta-row">
          {post.data.tags.length > 0 && (
            <ul aria-label="标签">
              {post.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )}
        </div>

        {post.data.description && <p class="description">{post.data.description}</p>}

        <div class="content">
          <Content />
        </div>
      </article>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --bg: #fafaf9;
    --surface: #ffffff;
    --surface-soft: #f5f5f4;
    --ink: #0c0a09;
    --muted: #6f6a63;
    --muted-2: #9a948c;
    --border: rgba(12, 10, 9, 0.09);
    --border-strong: rgba(12, 10, 9, 0.14);
    --accent: #3ba6f1;
    --accent-ink: #0969a8;
    --accent-soft: #eef8ff;
    --warm: #fff7ed;
    --shadow: rgba(17, 12, 46, 0.07) 0px 18px 54px 0px, rgba(0, 0, 0, 0.04) 0px 4px 16px 0px;
    --radius: 24px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    overflow-x: hidden;
    background:
      radial-gradient(circle at 12% 0%, rgba(59, 166, 241, 0.12), transparent 31rem),
      radial-gradient(circle at 90% 8%, rgba(255, 237, 213, 0.9), transparent 26rem),
      var(--bg);
    color: var(--ink);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
    line-height: 1.68;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .ambient {
    position: fixed;
    z-index: -1;
    border-radius: 999px;
    filter: blur(12px);
    opacity: 0.55;
    pointer-events: none;
  }

  .ambient-a {
    right: -140px;
    top: 160px;
    width: 360px;
    height: 360px;
    background: rgba(59, 166, 241, 0.14);
  }

  .ambient-b {
    left: -160px;
    bottom: 8vh;
    width: 320px;
    height: 320px;
    background: rgba(251, 191, 36, 0.12);
  }

  a {
    color: var(--accent-ink);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  a:hover,
  a:focus-visible {
    color: #075985;
  }

  .page {
    width: min(100%, 1040px);
    margin: 0 auto;
    padding: 38px 22px 86px;
  }

  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 18px;
  }

  .back,
  .pill {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0 14px;
    background: rgba(255, 255, 255, 0.72);
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 650;
    text-decoration: none;
    backdrop-filter: blur(14px);
  }

  .back:hover,
  .back:focus-visible {
    border-color: rgba(59, 166, 241, 0.35);
    color: var(--accent-ink);
  }

  .shell {
    border: 1px solid var(--border);
    border-radius: 32px;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: var(--shadow);
    overflow: hidden;
    backdrop-filter: blur(18px);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    align-items: end;
    padding: 54px 54px 30px;
    background:
      linear-gradient(135deg, rgba(238, 248, 255, 0.92), rgba(255, 255, 255, 0.58) 38%, rgba(255, 247, 237, 0.76)),
      var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--accent-ink);
    font-size: 0.76rem;
    font-weight: 760;
    letter-spacing: 0.16em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p,
  li {
    text-wrap: pretty;
  }

  h1 {
    max-width: 780px;
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 5.7rem);
    line-height: 0.94;
    letter-spacing: -0.07em;
    font-weight: 680;
  }

  .date-card {
    display: grid;
    gap: 8px;
    min-width: 168px;
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 18px;
    background: rgba(255, 255, 255, 0.72);
  }

  .date-card span {
    color: var(--muted-2);
    font-size: 0.68rem;
    font-weight: 760;
    letter-spacing: 0.14em;
  }

  .date-card time {
    color: var(--ink);
    font-size: 0.98rem;
    font-weight: 720;
    line-height: 1.35;
  }

  .meta-row {
    padding: 24px 54px 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    border-radius: 999px;
    padding: 6px 11px;
    color: var(--accent-ink);
    background: var(--accent-soft);
    font-size: 0.74rem;
    font-weight: 720;
    line-height: 1;
  }

  .description {
    max-width: 760px;
    margin: 22px 54px 0;
    color: var(--muted);
    font-size: 1.05rem;
    font-weight: 480;
    line-height: 1.72;
  }

  .content {
    padding: 16px 54px 58px;
    color: var(--ink);
    font-size: 1.03rem;
  }

  .content :global(> h1:first-child) {
    display: none;
  }

  .content :global(h2) {
    position: relative;
    margin: 2.35em 0 0.9em;
    border-top: 1px solid var(--border);
    padding-top: 1.35em;
    font-size: clamp(1.45rem, 4vw, 2.1rem);
    line-height: 1.13;
    letter-spacing: -0.045em;
    font-weight: 680;
  }

  .content :global(h2::before) {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 72px;
    height: 1px;
    background: var(--accent);
  }

  .content :global(h3) {
    display: inline-flex;
    align-items: center;
    margin: 2.1em 0 0.85em;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    padding: 8px 13px;
    background: var(--surface-soft);
    color: var(--ink);
    font-size: 0.92rem;
    line-height: 1.2;
    letter-spacing: -0.012em;
    font-weight: 720;
  }

  .content :global(h4) {
    margin: 1.25em 0 0.35em;
    color: var(--ink);
    font-size: clamp(1.05rem, 2vw, 1.18rem);
    line-height: 1.35;
    letter-spacing: -0.025em;
    font-weight: 680;
  }

  .content :global(h4 a) {
    color: var(--ink);
    text-decoration: none;
  }

  .content :global(h4 a:hover),
  .content :global(h4 a:focus-visible) {
    color: var(--accent-ink);
    text-decoration: underline;
  }

  .content :global(p) {
    margin: 0.92em 0;
    color: var(--muted);
  }

  .content :global(strong) {
    color: var(--ink);
    font-weight: 720;
  }

  .content :global(ul),
  .content :global(ol) {
    display: grid;
    gap: 10px;
    margin: 1.1em 0;
    padding: 0;
  }

  .content :global(li) {
    position: relative;
    display: block;
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 14px 16px 14px 40px;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.64);
    font: inherit;
    line-height: 1.62;
  }

  .content :global(ul > li::before) {
    content: "";
    position: absolute;
    left: 17px;
    top: 1.35em;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 4px rgba(59, 166, 241, 0.12);
  }

  .content :global(ol) {
    counter-reset: digest-item;
  }

  .content :global(ol > li) {
    counter-increment: digest-item;
    padding-left: 58px;
  }

  .content :global(ol > li::before) {
    content: counter(digest-item);
    position: absolute;
    left: 15px;
    top: 14px;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--surface-soft);
    color: var(--accent-ink);
    font-size: 0.75rem;
    font-weight: 760;
  }

  .content :global(blockquote) {
    margin: 1.25em 0;
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: 18px;
    padding: 16px 18px;
    background: var(--accent-soft);
    color: var(--muted);
  }

  .content :global(code) {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.12em 0.4em;
    background: var(--surface-soft);
    color: var(--ink);
    font-family: "SFMono-Regular", ui-monospace, Menlo, Monaco, Consolas, monospace;
    font-size: 0.88em;
  }

  .content :global(hr) {
    height: 1px;
    margin: 1.25em 0 1.45em;
    border: 0;
    background: var(--border);
  }

  @media (max-width: 760px) {
    .page {
      padding: 18px 12px 56px;
    }

    .shell {
      border-radius: 24px;
    }

    .hero {
      grid-template-columns: 1fr;
      gap: 22px;
      padding: 32px 24px 24px;
    }

    .date-card {
      min-width: 0;
    }

    h1 {
      font-size: clamp(2.25rem, 14vw, 3.65rem);
      line-height: 0.98;
    }

    .meta-row,
    .description {
      margin-left: 0;
      margin-right: 0;
      padding-left: 24px;
      padding-right: 24px;
    }

    .content {
      padding: 8px 24px 36px;
      font-size: 0.99rem;
    }

    .content :global(li) {
      padding-right: 14px;
    }
  }
</style>
